{
  "name": "zenith-finance-server",
  "version": "1.0.0",
  "description": "Backend API for Zenith Finance with PostgreSQL and Prisma",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && prisma generate",
